{
  "info": {
    "name": "FitTrack AI API",
    "_postman_id": "fittrack-ai-demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Rahul\", \"email\": \"rahul@example.com\", \"password\": \"password123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"rahul@example.com\", \"password\": \"password123\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Add Workout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"workoutName\": \"Morning Running\", \"category\": \"Cardio\", \"duration\": 30, \"caloriesBurned\": 250, \"workoutDate\": \"2026-09-27\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/workouts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts"
          ]
        }
      }
    },
    {
      "name": "Get Workouts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/workouts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts"
          ]
        }
      }
    },
    {
      "name": "Search Workouts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/workouts/search?name=running",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "workouts",
            "search"
          ],
          "query": [
            {
              "key": "name",
              "value": "running"
            }
          ]
        }
      }
    },
    {
      "name": "AI Recommendation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"age\": 20, \"fitnessGoal\": \"weight loss\", \"experienceLevel\": \"beginner\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/ai/recommendation",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ai",
            "recommendation"
          ]
        }
      }
    },
    {
      "name": "AI Fitness Insights",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ai/insights",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ai",
            "insights"
          ]
        }
      }
    }
  ]
}